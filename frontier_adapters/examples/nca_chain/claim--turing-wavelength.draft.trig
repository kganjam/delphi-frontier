sub:assertion {
  sub:claim a de:FrontierClaim ;
    rdfs:label "Turing wavelength selection" ;
    de:statement "The spacing of a Turing pattern at onset is set by the reaction rates and diffusivities, not by the size of the tissue, so changing these parameters predictably changes the number of repeated elements." ;
    de:frontierRecord "node-a/Claim/turing-wavelength@96df99f6d191afafd2305986184973c8ffbd04ba644618ba860cb6fc54019b8d" ;
    de:contentAvailable "false"^^xsd:boolean ;
