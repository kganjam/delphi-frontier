    de:delphiNanopub <https://w3id.org/np/RAjJiCpfgPzPI0Oidz7C5KIqYJuGw5iIhz-iukSDtzO08> ;
    de:delphiRegistry "production" ;
    de:sourceUri <https://doi.org/10.1098/rstb.1952.0012> .
}

