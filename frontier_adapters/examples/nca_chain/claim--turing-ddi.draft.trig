    de:delphiNanopub <https://w3id.org/np/RAaQ-9SCjYC7GBJ0ZtrPcVNxZBB7z-VNAdWa8ImGAi610> ;
    de:delphiRegistry "production" ;
    de:sourceUri <https://doi.org/10.1098/rstb.1952.0012> .
}

