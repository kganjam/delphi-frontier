sub:assertion {
  sub:claim a de:FrontierClaim ;
    rdfs:label "Turing diffusion-driven instability" ;
    de:statement "A homogeneous steady state of two reacting chemicals that is stable without diffusion can become unstable to spatial perturbations when the chemicals diffuse at different rates, spontaneously producing a pattern." ;
    de:frontierRecord "node-a/Claim/turing-ddi@7678f6c63e79dd1ddd976c2f972ab7c2ba11ee91099213e2ce7c6aeb88f6512f" ;
