sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:quantity a qudt:Quantity ;
    dct:identifier "ms:parameter/m" ;
    dct:title "Adult zebrafish body mass" ;
    qudt:symbol "m" ;
    qudt:value "0.0003 to 0.0005 (observed-range)" ;
    qudt:unit "kg" ;
    dct:conditionsOfUse "Adult, ~4 cm SL" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom "literature" ;
    dct:accrualMethod "measured" ;
    dct:accessRights "abstract" ;
    dct:description "Standard reference value for adult Danio." ;
    prov:generatedAtTime "2026-11-04 09:22:28.99318+00" ;
    prov:wasGeneratedBy "swarm/export_transfer.py ask-transfer/v1" .
}

sub:pubinfo {
  this: dct:created "2026-11-05T01:18:51+00:00"^^xsd:dateTime ;
    dct:creator "delphi-frontier swarm (DRY RUN, throwaway key)" ;
    dct:isReplacedBy "not-superseded" ;
