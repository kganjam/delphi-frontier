      "enabled": true,
      "use_2D": false
    },
    "cycle": "live (code 5), transition rate 0 (no proliferation)",
    "death_rates": "apoptosis 0, necrosis 0",
    "dt_mechanics_min": 0.1,
    "dt_phenotype_min": 6.0,
    "dt_diffusion_min": 0.1,
    "substrate": "template dummy 'substrate', no secretion/uptake",
    "domain_um": [
      -200.0,
      200.0
    ],
    "voxel_um": 20.0,
    "virtual_wall_at_domain_edge": true,
    "horizon_min": 14400.0,
    "n_saves": 10,
    "omp_threads_per_run": 1,
    "seeds": [
      1,
      2
    ],
    "physicell_random_seed": "options/random_seed = seed; numpy default_rng(seed) for placement",
    "rationale": "Pre-run force-balance calculation (no simulation): PhysiCell pair potential is v = c_a*sqrt(a_ij a_ji)*(1-d/S)^2 - c_r*(1-d/R)^2 with S = 1.25 R. With the template defaults (c_a=0.4, c_r=10) the well depth is ~0.03 um^2/min, far below the effective 'temperature' of the random walk D = s^2 tau/3 = 0.42 um^2/min (s=0.5 um/min, tau=5 min), so nothing would stay bound. c_r=25, c_a=12 gives well depths AA(1.0) 3.4, AB(0.6) 1.2, BB(0.4) 0.64 um^2/min, equilibrium spacings 0.69-0.87 x sum of radii. The suggested B-B 0.2 / A-B 0.4 would give B-B depth ~0.25 (< D) and A-B ~0.64, so B cells would mostly not stay bound; B-B 0.4 / A-B 0.6 was chosen instead. DAH ordering AA > AB > BB and AB < (AA+BB)/2 = 0.7 holds (sorting with A core)."
  },
  "metric_definitions": {
    "touching": "distance < 1.05 x (r_i + r_j)",
    "n_aggregates": "connected components of the touching graph (singletons count)",
    "largest_cluster_fraction": "largest component size / N",
    "rg_norm": "Rg / (N^(1/3) x mean radius), Rg about centroid of all cells",
    "sorting_index_homotypic": "fraction of touching pairs that are same-type",
    "core_shell_index": "(mean radial distance of B - mean radial distance of A) / Rg, centroid of all cells",
    "asphericity": "(l1 - (l2+l3)/2)/(l1+l2+l3), gyration-tensor eigenvalues l1>=l2>=l3",
    "kappa2": "relative shape anisotropy",
    "core_shell_index_largest_cluster": "diagnostic only: same index within the largest cluster"
  },
  "criteria": {
    "zero": "final rg_norm >= 0.95 x initial",
    "equal": "|core_shell_index| < 0.1 and sorting_index_homotypic < 0.6 (final)",
    "dah": "largest_cluster_fraction >= 0.9 and rg_norm drop >= 20% and core_shell_index > 0.1 (final)"
  },
