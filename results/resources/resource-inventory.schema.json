{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delphi-frontier.invalid/schemas/resource-inventory-1.json",
  "title": "Delphi Frontier resource inventory",
  "type": "object",
  "required": ["schema_version", "observed_at", "scope", "compute", "historical_gpu_telemetry", "model_usage", "worker_inventory", "cost", "sources"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "frontier.resource-inventory/1"},
    "observed_at": {
      "type": "object",
      "required": ["utc", "seattle"],
      "properties": {"utc": {"type": "string", "format": "date-time"}, "seattle": {"type": "string", "pattern": "PDT \\(UTC-07:00\\)|PST \\(UTC-08:00\\)"}},
      "additionalProperties": false
    },
    "scope": {"type": "object", "required": ["project", "limitations"], "properties": {"project": {"type": "string"}, "nebius_filter": {"type": "string"}, "limitations": {"type": "array", "items": {"type": "string"}}}},
    "compute": {"type": "object", "required": ["nebius", "google_compute", "launch_outcomes"], "properties": {"nebius": {"type": "object"}, "google_compute": {"type": "object"}, "launch_outcomes": {"type": "object"}}},
    "historical_gpu_telemetry": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["task_label", "source", "sha256", "window_utc", "samples", "gpu_utilization_pct_mean", "gpu_utilization_pct_max"], "properties": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "window_utc": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "format": "date-time"}}, "samples": {"type": "integer", "minimum": 1}, "gpu_utilization_pct_mean": {"type": "number", "minimum": 0, "maximum": 100}, "gpu_utilization_pct_max": {"type": "number", "minimum": 0, "maximum": 100}}}},
    "model_usage": {"type": "object", "required": ["gemini_embedding_index", "bioservices_gemini_calls", "total_provider_llm_usage"], "properties": {"gemini_embedding_index": {"type": "object"}, "bioservices_gemini_calls": {"type": "object"}, "total_provider_llm_usage": {"type": "string"}}},
    "worker_inventory": {"type": "object", "required": ["native_agents", "selected_frontier_tmux_panes"], "properties": {"native_agents": {"type": "object"}, "selected_frontier_tmux_panes": {"type": "object", "properties": {"count": {"type": "integer", "minimum": 0}, "classification": {"enum": ["actively_working", "authblocked", "idle", "unknown"]}, "panes": {"type": "array", "items": {"type": "string"}}}}}},
    "cost": {"type": "object", "required": ["actual_billing_meter_queried", "actual_spend", "interpretation"], "properties": {"actual_billing_meter_queried": {"type": "boolean"}, "actual_spend": {"type": ["number", "null"]}, "interpretation": {"type": "string"}}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["kind", "source"], "properties": {"kind": {"type": "string"}, "source": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
  }
}
