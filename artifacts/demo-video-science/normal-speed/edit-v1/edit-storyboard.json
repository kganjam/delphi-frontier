      "id": "frontier-science-120s",
      "scenes": [
        {
          "duration_s": 11.454,
          "headline": "Lean for biology",
          "id": "question",
          "narration": "Lean for biology: mathematical claims, explicit assumptions, machine-checkable consequences.",
          "start_s": 0.0
        },
        {
          "duration_s": 13.326,
          "headline": "Formal claims make knowledge reusable",
          "id": "commons",
          "narration": "Formalized knowledge enables reusable constraints, compatible models, candidate designs and experiments aimed at missing evidence.",
          "start_s": 11.454
        },
        {
          "duration_s": 11.994,
          "headline": "A demanding test case: a flying fish",
          "id": "specimens",
          "narration": "Our test case asks whether zebrafish-inspired fin designs could glide. Published fin-growth genetics and flying-fish measurements frame it.",
          "start_s": 24.78
        },
        {
          "duration_s": 16.782,
          "headline": "A conditional theorem, compiled and tested",
          "id": "mechanics",
          "narration": "Lean compiled a fin-beam stiffness bound and rejected a corrupted law. Two computations reused a versioned mechanics claim; independent review kept numerical checks alongside biological questions.",
          "start_s": 36.774
        },
        {
          "duration_s": 20.454,
          "headline": "Virtual instruments across scales",
          "id": "studio",
          "narration": "The studio links sequence candidates, bioelectricity, mechanics, aerodynamics and collective behavior. Equations, controls, evidence and virtual instruments expose model predictions, not measurements.",
          "start_s": 53.556
        },
        {
          "duration_s": 16.602,
          "headline": "A biological compiler is an intended output",
          "id": "limits",
          "narration": "The biological compiler aims to output candidate DNA, a build plan and validation strategy. Today it checks linked artifacts and exposes missing interfaces.",
          "start_s": 74.00999999999999
        },
        {
          "duration_s": 14.874,
          "headline": "Predictions need tests",
          "id": "validation",
          "narration": "Like AlphaFold predictions, candidates need testing. Formal checks, numerical controls and observations turn failures into targeted experiments.",
          "start_s": 90.612
        },
        {
          "duration_s": 14.514000000000014,
          "headline": "Build a shared, checkable foundation",
          "id": "community",
          "narration": "MCP lets people and agents contribute, challenge and reuse exact work. The flying fish is one test of a shared, checkable foundation for engineering biology.",
          "start_s": 105.48599999999999
        }
      ],
      "title": "Lean for biology · two-minute science cut"
    }
  ],
