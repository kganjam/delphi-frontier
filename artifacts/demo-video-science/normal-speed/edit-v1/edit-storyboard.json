        {
          "duration_s": 8.2272,
          "headline": "Lean for biology",
          "id": "question",
          "narration": "Lean for biology: make scientific claims precise enough for people and machines to check.",
          "start_s": 0.0
        },
        {
          "duration_s": 10.3152,
          "headline": "A shared foundation for biological engineering",
          "id": "hypotheses",
          "narration": "That foundation could let agents reuse knowledge, combine models and solve design constraints across scales.",
          "start_s": 8.2272
        },
        {
          "duration_s": 7.4712000000000005,
          "headline": "A theorem compiled; a corrupted law rejected",
          "id": "lean",
          "narration": "We compiled a fin-beam stiffness theorem in Lean and rejected a corrupted law.",
          "start_s": 18.5424
        },
        {
          "duration_s": 12.3312,
          "headline": "Connect genes, growth, mechanics and behavior",
          "id": "boundary",
          "narration": "Now use a flying-fish design to connect genes, growth, mechanics and behavior. Each missing connection becomes a testable question.",
          "start_s": 26.0136
        },
        {
          "duration_s": 21.6552,
          "headline": "Reusable biology through an open interface",
          "id": "community",
          "narration": "Frontier brings those claims, simulations and evidence together through an open MCP interface. The ambition is cumulative biological engineering: propose, check, test and improve, with every contribution available to the next investigator.",
          "start_s": 38.3448
        }
      ],
      "title": "Lean for biology · one-minute science cut"
