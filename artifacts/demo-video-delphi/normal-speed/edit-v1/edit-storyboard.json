      "id": "frontier-delphi-120s",
      "scenes": [
        {
          "duration_s": 11.254285714285714,
          "headline": "Delphi · a shared mathematical foundation",
          "id": "commons",
          "narration": "What if biology had a shared mathematical foundation that people and machines could check? That is the ambition behind Delphi: Lean for biology.",
          "start_s": 0.0
        },
        {
          "duration_s": 16.798285714285715,
          "headline": "Claims, equations and sources travel together",
          "id": "model",
          "narration": "Start with a claim from the literature. Make its equations and assumptions explicit. Attach the evidence. Formalization creates a foundation for reuse, constraint solving and engineering across scales.",
          "start_s": 11.254285714285714
        },
        {
          "duration_s": 21.298285714285715,
          "headline": "A versioned theorem and independent review",
          "id": "proof",
          "narration": "Our Frontier extension already checks a fin-beam stiffness theorem in Lean, including a corrupted law that fails. Two computations reused a versioned mechanics claim. Independent review checked the calculations and kept questions about biological relevance attached.",
          "start_s": 28.05257142857143
        },
        {
          "duration_s": 15.970285714285714,
          "headline": "Biological compiler · intended output",
          "id": "compiler",
          "narration": "Now imagine a biological compiler, starting with zebrafish: candidate DNA, a build plan and a validation strategy. Our current compiler checks linked artifacts and reveals the missing connections.",
          "start_s": 49.350857142857144
        },
        {
          "duration_s": 18.958285714285715,
          "headline": "Compare dimensions, leave gaps visible",
          "id": "comparison",
          "narration": "Compare the reference fish, an engineered candidate and natural flying fish across gene context, fin shape, mechanics and behavior. Explore functional replacements, then test their effects in the relevant biological context.",
          "start_s": 65.32114285714286
        },
        {
          "duration_s": 16.618285714285715,
          "headline": "Virtual instruments and targeted experiments",
          "id": "evidence",
          "narration": "Like AlphaFold predictions, candidates need testing. Combine proofs, virtual instruments and observations; target experiments around uncertainty, then update shared evidence.",
          "start_s": 84.27942857142858
        },
        {
          "duration_s": 19.1022857142857,
          "headline": "Reusable biology through community work",
          "id": "community",
          "narration": "MCP lets people and agents retrieve exact evidence, contribute results and contest claims. This is a community building reusable biology. The flying fish is one test case; the ambition reaches far beyond it.",
          "start_s": 100.8977142857143
        }
      ],
      "title": "Delphi · two-minute vision cut"
    }
  ],
