<VXA Version="1.1">
<!-- Frozen probe case, derived from voxcraft-sim demos/basic/base.vxa at commit
     dd8668f99ff74fb2fc2ee60deb91287a3b519d8f. Every key below was read from the source
     at that commit, not from documentation:
       VXA.Simulator.RecordHistory.*  VX3_SimulationManager.cu:344-346
       VXA.Simulator.EnableExpansion  VX3_SimulationManager.cu:367 (default 0)
       VXA.GPU.PrintfFIFOSize         VX3_SimulationManager.cu:376 (default 50)
       VXA.Environment.Thermal.*      old/VX_Environment.cpp ReadXML
       VXA.Environment.Gravity.*      old/VX_Environment.cpp ReadXML
       Mechanical CTE/uStatic/uDynamic  VXA/VX_Object.cpp:1445-1447
     Actuation law, VX3_VoxelyzeKernel.cu:636-646:
       T(t) = TempAmplitude * sin(2*pi*(t/TempPeriod + phaseOffset)), CLIPPED AT ZERO
       because EnableExpansion is 0, so voxels only CONTRACT. TempBase is NOT used on
       the CUDA path. Zero-stress size is size*(1 + T*CTE): 10.0 mm down to 9.0 mm.
     Generic soft-voxel mechanics. No biological fidelity is claimed. -->
<Simulator>
    <RecordHistory>
        <RecordStepSize>100</RecordStepSize>
        <RecordVoxel>1</RecordVoxel>
        <RecordLink>0</RecordLink>
    </RecordHistory>
    <EnableExpansion>0</EnableExpansion>
    <StopCondition>
        <StopConditionFormula>
            <mtSUB>
            <mtVAR>t</mtVAR>
            <mtCONST>0.5</mtCONST>
            </mtSUB>
        </StopConditionFormula>
    </StopCondition>
</Simulator>
<Environment>
    <Gravity>
        <GravEnabled>1</GravEnabled>
        <GravAcc>-9.81</GravAcc>
        <FloorEnabled>1</FloorEnabled>
    </Gravity>
    <Thermal>
        <TempEnabled>1</TempEnabled>
        <TempAmplitude>10</TempAmplitude>
        <TempBase>0</TempBase>
        <VaryTempEnabled>0</VaryTempEnabled>
        <TempPeriod>0.25</TempPeriod>
    </Thermal>
</Environment>
<GPU>
    <PrintfFIFOSize>200</PrintfFIFOSize>
</GPU>
<VXC Version="0.94">
    <Lattice>
        <Lattice_Dim>0.01</Lattice_Dim>
    </Lattice>
    <Palette>
        <Material>
            <Name>ProbeMaterial</Name>
            <Display><Red>1</Red><Green>0</Green><Blue>0</Blue><Alpha>1</Alpha></Display>
            <Mechanical>
                <MatModel>0</MatModel>
                <Elastic_Mod>1e+05</Elastic_Mod>
                <Fail_Stress>0</Fail_Stress>
                <Density>1e+3</Density>
                <Poissons_Ratio>0.35</Poissons_Ratio>
                <CTE>0.01</CTE>
                <MaterialTempPhase>0</MaterialTempPhase>
                <uStatic>1</uStatic>
                <uDynamic>0.8</uDynamic>
            </Mechanical>
        </Material>
    </Palette>
    <Structure Compression="ASCII_READABLE">
        <X_Voxels>4</X_Voxels>
        <Y_Voxels>4</Y_Voxels>
        <Z_Voxels>2</Z_Voxels>
        <Data>
            <Layer><![CDATA[1111111111111111]]></Layer>
            <Layer><![CDATA[1111111111111111]]></Layer>
        </Data>
    </Structure>
</VXC>
</VXA>
