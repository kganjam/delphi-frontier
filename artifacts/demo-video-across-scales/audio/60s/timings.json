  "sentences": [
    {
      "id": 1,
      "text": "Type: “Design a fish that can fly.”",
      "source_char_begin": 0,
      "source_char_end": 35,
      "raw_start_s": 0.035556,
      "raw_end_s": 1.92,
      "start_s": 0.033298,
      "end_s": 1.798095
    },
    {
      "id": 2,
      "text": "That’s the promise of a biological compiler.",
      "source_char_begin": 35,
      "source_char_end": 81,
      "raw_start_s": 2.382222,
      "raw_end_s": 4.266667,
      "start_s": 2.23097,
      "end_s": 3.995767
    },
    {
      "id": 3,
      "text": "Delphi Bio and MorphoSwarm Studio bring a decentralized swarm of agents to the challenge—proposing, simulating, and challenging each other’s designs.",
      "source_char_begin": 81,
      "source_char_end": 232,
      "raw_start_s": 4.791156,
      "raw_end_s": 12.186712,
      "start_s": 4.486956,
      "end_s": 11.412953
    },
    {
      "id": 4,
      "text": "They apply mathematical biology.",
      "source_char_begin": 232,
      "source_char_end": 265,
      "raw_start_s": 12.328934,
      "raw_end_s": 14.142268,
      "start_s": 11.546145,
      "end_s": 13.244346
    },
    {
      "id": 5,
      "text": "Can oxygen delivery support launch power?",
      "source_char_begin": 265,
      "source_char_end": 308,
      "raw_start_s": 14.666757,
      "raw_end_s": 16.764535,
      "start_s": 13.735535,
      "end_s": 15.70012
    },
    {
      "id": 6,
      "text": "Could proteins make fins tougher without adding weight?",
      "source_char_begin": 308,
      "source_char_end": 364,
      "raw_start_s": 17.013424,
      "raw_end_s": 19.60898,
      "start_s": 15.933207,
      "end_s": 18.363965
    },
    {
      "id": 7,
      "text": "Which signals shape growth?",
      "source_char_begin": 364,
      "source_char_end": 392,
      "raw_start_s": 19.822313,
      "raw_end_s": 21.102313,
      "start_s": 18.563753,
      "end_s": 19.762484
    },
    {
      "id": 8,
      "text": "How would a school coordinate—and change its ecosystem?",
      "source_char_begin": 392,
      "source_char_end": 448,
      "raw_start_s": 21.671556,
      "raw_end_s": 23.947111,
      "start_s": 20.295584,
      "end_s": 22.42666
    },
    {
      "id": 9,
      "text": "Bigger fins may help lift.",
      "source_char_begin": 448,
      "source_char_end": 476,
      "raw_start_s": 24.302667,
      "raw_end_s": 25.369333,
      "start_s": 22.75964,
      "end_s": 23.758582
    },
    {
      "id": 10,
      "text": "What do they cost in drag, strength, and energy?",
      "source_char_begin": 476,
      "source_char_end": 525,
      "raw_start_s": 25.618222,
      "raw_end_s": 28.533778,
      "start_s": 23.991668,
      "end_s": 26.722109
    },
    {
      "id": 11,
      "text": "We extract mathematical laws from literature and data, make assumptions explicit, and formally check deductions.",
      "source_char_begin": 525,
      "source_char_end": 639,
      "raw_start_s": 29.410921,
      "raw_end_s": 35.028698,
      "start_s": 27.543561,
      "end_s": 32.804654
    },
    {
      "id": 12,
      "text": "Compatible models become building blocks, with control knobs to explore.",
      "source_char_begin": 639,
      "source_char_end": 712,
      "raw_start_s": 35.206476,
      "raw_end_s": 39.046476,
      "start_s": 32.971144,
      "end_s": 36.567335
    },
    {
      "id": 13,
      "text": "Agents propose simulations and experiments across scales.",
      "source_char_begin": 712,
      "source_char_end": 771,
      "raw_start_s": 39.330921,
      "raw_end_s": 42.068698,
      "start_s": 36.833719,
      "end_s": 39.39767
    },
    {
      "id": 14,
      "text": "Each simulation should answer a design question.",
      "source_char_begin": 771,
      "source_char_end": 820,
      "raw_start_s": 42.731556,
      "raw_end_s": 44.580444,
      "start_s": 40.018441,
      "end_s": 41.74994
    },
    {
      "id": 15,
      "text": "What we learn returns to Delphi—with evidence, uncertainty, disagreement, and limits—so the next design starts smarter.",
      "source_char_begin": 820,
      "source_char_end": 940,
      "raw_start_s": 44.900444,
      "raw_end_s": 51.727111,
      "start_s": 42.049623,
      "end_s": 48.44285
    },
    {
      "id": 16,
      "text": "The pieces of verified biology are coming together.",
      "source_char_begin": 940,
      "source_char_end": 993,
      "raw_start_s": 51.976,
      "raw_end_s": 54.073778,
      "start_s": 48.675937,
      "end_s": 50.640522
    },
    {
      "id": 17,
      "text": "The destination: candidate DNA, with a plan to build and test it.",
      "source_char_begin": 993,
      "source_char_end": 1060,
      "raw_start_s": 54.778222,
      "raw_end_s": 58.938222,
      "start_s": 51.30024,
      "end_s": 55.196113
    },
    {
      "id": 18,
      "text": "From a sentence to an organism.",
      "source_char_begin": 1060,
      "source_char_end": 1093,
      "raw_start_s": 0.035556,
      "raw_end_s": 1.457778,
      "start_s": 55.535556,
      "end_s": 56.957778,
      "timing_source": "new paired ending, provider timestamps"
    },
    {
      "id": 19,
      "text": "What would you build?",
      "source_char_begin": 1093,
      "source_char_end": 1115,
      "raw_start_s": 1.635556,
      "raw_end_s": 2.737778,
      "start_s": 57.135556,
      "end_s": 58.237778,
      "timing_source": "new paired ending, provider timestamps"
    }
  ],
