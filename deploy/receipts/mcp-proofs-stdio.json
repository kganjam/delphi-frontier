      {
        "id": "geometric-similarity",
        "title": "Geometric similarity: wing loading and speed scaling",
        "summary": "Under similarity with length ratio k (area k squared, mass k cubed, same air density, lift coefficient and gravity), wing loading scales as k and the level-flight proxy speed as the square root of k. A solver-emitted conflict certificate is also checked.",
        "assumptions": [
          "Every symbol is a positive real number.",
          "Air density, lift coefficient and gravity are unchanged between the two sizes.",
          "Mass ratio k^3 and area ratio k^2 are assumptions of the model (hypotheses of the theorem), not derived.",
          "The lift condition is a level-flight proxy (L = W), not a glide analysis."
        ],
        "equations": [
          {
            "label": "Wing loading",
            "tex": "WL=\\frac{m\\,g}{S}"
          },
          {
            "label": "Level-flight proxy speed",
            "tex": "V=\\sqrt{\\frac{2\\,m\\,g}{\\rho\\,S\\,C}}"
          },
          {
            "label": "Wing loading under similarity (area k^2, mass k^3)",
            "tex": "WL(k^{3}m,\\,k^{2}S)=k\\,WL(m,S)"
          },
          {
            "label": "Speed under similarity",
            "tex": "V(k^{3}m,\\,k^{2}S)=\\sqrt{k}\\,V(m,S)"
          },
          {
            "label": "Wing-loading ceiling at speed V",
            "tex": "2\\,m\\,g\\le V^{2}\\rho S C\\ \\Rightarrow\\ 2\\,WL\\le \\rho V^{2}C"
          }
        ],
