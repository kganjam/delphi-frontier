      {
        "id": "cantilever-guard",
        "title": "Cantilever guard: a small-deflection bound with satisfiable hypotheses",
        "summary": "For every positive P, L, E and I, if the end-load law 3EId = PL^3 holds and the bending stiffness satisfies 10 P L^2 <= 3 E I, then the deflection satisfies d <= L/10. The hypotheses are shown to be satisfiable, and the stiffness hypothesis is shown to be necessary.",
        "assumptions": [
          "P, L, E and I are positive reals.",
          "The Euler-Bernoulli end-load law is a stated hypothesis, not shown to model a fin ray.",
          "No real stiffness is shown to satisfy the stiffness hypothesis."
        ],
        "equations": [
          {
            "label": "End-load law (stated)",
            "tex": "3\\,E\\,I\\,d=P\\,L^{3}"
          },
          {
            "label": "Stiffness hypothesis",
            "tex": "10\\,P\\,L^{2}\\le 3\\,E\\,I"
          },
          {
            "label": "Guard conclusion",
            "tex": "d\\le \\frac{L}{10}"
          }
        ],
