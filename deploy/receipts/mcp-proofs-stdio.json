      {
        "id": "unit-algebra",
        "title": "Unit algebra: conversion, interval mapping and dimensions",
        "summary": "The arithmetic the coupling checker relies on when it validates a unit conversion: converting twice equals converting by the product, a positive factor keeps order and sign, a nonzero factor is undone by its inverse, and dimension exponents add.",
        "assumptions": [
          "Values are exact rationals (conversion) and integer exponents (dimensions).",
          "A positive factor is required for the interval rule; the control shows it is necessary.",
          "Units themselves (what a kilogram is) are conventions checked in Python, not here."
        ],
        "equations": [
          {
            "label": "Conversion composes",
            "tex": "(x f)\\,g=x\\,(f g)"
          },
          {
            "label": "Interval mapped by a positive factor",
            "tex": "lo\\le x\\le hi,\\ f>0\\ \\Rightarrow\\ lo\\,f\\le x f\\le hi\\,f"
          },
          {
            "label": "Dimension exponents add",
            "tex": "\\dim(dst)=\\dim(src)+\\dim(f)"
          }
        ],
