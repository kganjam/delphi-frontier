import Mathlib.Tactic

/-!
# Actuation-to-motion: when a periodically actuated soft body can and cannot translate

Hand-authored statements for the contractile tissue microcarrier project
(`project-tissue-microcarrier`). Derivations and symbol tables are in
`docs/xenomodel/actuation-motion-equations.md`; the equation records are in
`artifacts/xenomodel/equations.json`.

Three discrete-time models, each written to mirror an engine update that is
actually run in this repository:

* **A. Inertial lattice with absolute-frame damping** (pinned Voxelyze
  `4287e365`, `src/VX_Voxel.cpp`, `CVX_Voxel::timeStep` and `force()`):
  `p ← p + dt·(F_int − (C/m)·p + F_ext)`, `x ← x + dt·p/m`.
  Theorem: with homogeneous mass `m`, one damping coefficient `C`, internal forces
  that sum to zero, zero external horizontal force and zero initial momentum,
  the horizontal centre of mass never moves, whatever the actuation pattern.
  Its contrapositive is the necessity statement: a horizontal COM displacement
  requires a nonzero external horizontal force at some step (or nonzero initial
  momentum). A proved counterexample shows homogeneous mass cannot be dropped.

* **B. Overdamped lattice with linear drag** (PhysiCell 1.14.2 mechanics with
  unit mobility is the special case `ξ_i = 1`):
  `ξ_i·(x_{n+1,i} − x_{n,i}) = dt·F_int,n,i`.
  Theorem: the drag-weighted centroid is invariant at every step, for any
  heterogeneous drag, any body shape and any actuation (including phase
  gradients). Consequence: after a cycle that returns the body to a rigidly
  translated copy of its shape, the translation is zero. A phase gradient or an
  asymmetric body is therefore NOT sufficient for net motion under linear drag.

* **C. Two-node crawler with direction-dependent (anisotropic) friction**:
  friction force `f(v) = ξp·v` for `v ≥ 0`, `ξm·v` for `v < 0`; force balance
  `f(a₁) + f(a₂) = 0`; prescribed length change `a₂ − a₁ = δ`.
  Theorem: each step moves the midpoint by `κ·|δ|` with
  `κ = (ξm − ξp) / (2(ξp + ξm))`, so over any actuation history the net
  displacement is `κ` times the total variation of the length; a full
  contraction/extension cycle of amplitude `A` gives `A(ξm − ξp)/(ξp + ξm)`.
  Net displacement is zero if and only if `ξp = ξm` (for nonzero actuation):
  the friction anisotropy is necessary AND sufficient here.

Scope: algebra of the stated discrete models only. Nothing here shows that any
engine implements these updates beyond the source lines cited, that any tissue
contracts, or that a built construct moves. The sources for the project report
ciliary locomotion; contraction is this project's modelling choice.
-/

namespace ActuationMotion

open Finset BigOperators

/-! ## A. Inertial lattice with absolute-frame `-C·v` damping (Voxelyze form) -/

/-- One symplectic-Euler step on momentum, matching `linMom += curForce*dt` with
`curForce = F_int − C·(linMom/m) + F_ext` (global damping `-C*v`). -/
noncomputable def momentumStep (m C dt Fint Fext p : ℝ) : ℝ :=
  p + dt * (Fint - (C / m) * p + Fext)

/-- Total horizontal momentum after one step: internal forces cancel, damping
scales the total, external forces add. -/
theorem total_momentum_step {N : ℕ} (m C dt : ℝ) (Fint Fext p : Fin N → ℝ)
    (hint : ∑ i, Fint i = 0) :
    ∑ i, momentumStep m C dt (Fint i) (Fext i) (p i)
      = (1 - dt * (C / m)) * ∑ i, p i + dt * ∑ i, Fext i := by
  unfold momentumStep
  have h1 : ∀ i, p i + dt * (Fint i - C / m * p i + Fext i)
      = (1 - dt * (C / m)) * p i + dt * Fint i + dt * Fext i := by intro i; ring
  simp only [h1, sum_add_distrib, ← mul_sum, hint]
  ring

/-- **No-net-displacement theorem (inertial, absolute damping).** For every
trajectory generated by the Voxelyze-form update with homogeneous mass `m > 0`,
one damping coefficient `C`, internal forces summing to zero at every step, zero
external horizontal force at every step and zero initial total momentum, the sum
of horizontal positions (N × COM) is constant for all steps. No hypothesis on the
actuation pattern, phase gradient or body shape is needed. -/
theorem com_fixed_absolute_damping {N : ℕ} (m C dt : ℝ) (_hm : 0 < m)
    (x p Fint Fext : ℕ → Fin N → ℝ)
    (hp : ∀ n i, p (n + 1) i = momentumStep m C dt (Fint n i) (Fext n i) (p n i))
    (hx : ∀ n i, x (n + 1) i = x n i + dt * p (n + 1) i / m)
    (hint : ∀ n, ∑ i, Fint n i = 0)
    (hext : ∀ n, ∑ i, Fext n i = 0)
    (hp0 : ∑ i, p 0 i = 0) :
    ∀ n, ∑ i, x n i = ∑ i, x 0 i := by
  have hP : ∀ n, ∑ i, p n i = 0 := by
    intro n
    induction n with
    | zero => exact hp0
    | succ k ih =>
      simp only [hp]
      rw [total_momentum_step m C dt (Fint k) (Fext k) (p k) (hint k), ih, hext k]
      ring
  intro n
  induction n with
  | zero => rfl
  | succ k ih =>
    simp only [hx]
    rw [sum_add_distrib, ← ih]
    have : ∑ i, dt * p (k + 1) i / m = dt * (∑ i, p (k + 1) i) / m := by
      rw [mul_sum, sum_div]
    rw [this, hP (k + 1)]
    simp

/-- Closed form for the total momentum with zero external force: it decays
geometrically by the factor `1 − dt·C/m` per step. -/
theorem total_momentum_closed_form {N : ℕ} (m C dt : ℝ)
    (p Fint Fext : ℕ → Fin N → ℝ)
    (hp : ∀ n i, p (n + 1) i = momentumStep m C dt (Fint n i) (Fext n i) (p n i))
    (hint : ∀ n, ∑ i, Fint n i = 0)
    (hext : ∀ n, ∑ i, Fext n i = 0) :
    ∀ n, ∑ i, p n i = (1 - dt * (C / m)) ^ n * ∑ i, p 0 i := by
  intro n
  induction n with
  | zero => simp
  | succ k ih =>
    simp only [hp]
    rw [total_momentum_step m C dt (Fint k) (Fext k) (p k) (hint k), ih, hext k]
    ring

/-- **Necessity (contrapositive of the theorem above).** Under the same update,
homogeneous mass and internal-force cancellation, if the horizontal COM has
moved by step `n`, then either the initial total momentum was nonzero or some
step carried a nonzero total external horizontal force. Locomotion on a surface
requires an external horizontal force; in the frictionless engine there is none. -/
theorem com_motion_requires_external_force {N : ℕ} (m C dt : ℝ) (hm : 0 < m)
    (x p Fint Fext : ℕ → Fin N → ℝ)
    (hp : ∀ n i, p (n + 1) i = momentumStep m C dt (Fint n i) (Fext n i) (p n i))
    (hx : ∀ n i, x (n + 1) i = x n i + dt * p (n + 1) i / m)
    (hint : ∀ n, ∑ i, Fint n i = 0)
    (n : ℕ) (hmoved : ∑ i, x n i ≠ ∑ i, x 0 i) :
    (∑ i, p 0 i ≠ 0) ∨ (∃ k, ∑ i, Fext k i ≠ 0) := by
  by_contra h
  push Not at h
  exact hmoved (com_fixed_absolute_damping m C dt hm x p Fint Fext hp hx hint h.2 h.1 n)

/-- Heterogeneous-mass update (per-node mass `mᵢ`, one damping `C`): the form the
theorem above does NOT cover. -/
noncomputable def momentumStepHet (mi C dt Fint Fext p : ℝ) : ℝ :=
  p + dt * (Fint - (C / mi) * p + Fext)

/-- **Homogeneous mass is a necessary hypothesis.** A concrete two-node instance:
masses 1 and 2, damping C = 1, dt = 1/2, internal pair force ±1 at step 0 and 0 at
step 1, no external force, zero initial momentum. The mass-weighted COM moves
(`∑ mᵢ xᵢ` changes from 0 to -1/8 after two steps). Equal-and-opposite internal
forces plus uniform `-C·v` damping on unequal masses produce net translation. -/
theorem heterogeneous_mass_breaks_com :
    let mass : Fin 2 → ℝ := ![1, 2]
    let F0 : Fin 2 → ℝ := ![1, -1]
    let p1 : Fin 2 → ℝ := fun i => momentumStepHet (mass i) 1 (1/2) (F0 i) 0 0
    let x1 : Fin 2 → ℝ := fun i => 0 + (1/2) * p1 i / mass i
    let p2 : Fin 2 → ℝ := fun i => momentumStepHet (mass i) 1 (1/2) 0 0 (p1 i)
    let x2 : Fin 2 → ℝ := fun i => x1 i + (1/2) * p2 i / mass i
    (∑ i, F0 i = 0) ∧ (∑ i, mass i * x2 i ≠ ∑ i, mass i * (0 : ℝ)) := by
  simp [momentumStepHet, Fin.sum_univ_two]
  norm_num

/-- Satisfiability of the hypotheses of `com_fixed_absolute_damping` by a body
that genuinely deforms: two nodes, m = 1, C = 1/2, dt = 1/10, internal pair force
±1 every step. The nodes separate (x₁ − x₀ changes) while ∑x stays 0. -/
theorem absolute_damping_hypotheses_satisfiable :
    let p1 : Fin 2 → ℝ := fun i => momentumStep 1 (1/2) (1/10) (![-1, 1] i) 0 0
    let x1 : Fin 2 → ℝ := fun i => 0 + (1/10) * p1 i / 1
    (∑ i, x1 i = 0) ∧ (x1 1 - x1 0 ≠ 0) := by
  norm_num [momentumStep, Fin.sum_univ_two]

/-! ## B. Overdamped lattice with linear (possibly heterogeneous) drag -/

/-- **Drag-weighted centroid invariance.** If every node obeys the overdamped
linear-drag update `ξᵢ·(x_{n+1,i} − x_{n,i}) = dt·F_{n,i}` and the forces are
internal (sum to zero at every step), then `∑ ξᵢ xᵢ` is constant for all steps.
No hypothesis on the actuation (phase gradient, travelling wave) or on body
symmetry is used. -/
theorem drag_weighted_centroid_fixed {N : ℕ} (dt : ℝ) (ξ : Fin N → ℝ)
    (x F : ℕ → Fin N → ℝ)
    (hstep : ∀ n i, ξ i * (x (n + 1) i - x n i) = dt * F n i)
    (hint : ∀ n, ∑ i, F n i = 0) :
    ∀ n, ∑ i, ξ i * x n i = ∑ i, ξ i * x 0 i := by
  intro n
  induction n with
  | zero => rfl
  | succ k ih =>
    have h : ∀ i, ξ i * x (k + 1) i = ξ i * x k i + dt * F k i := by
      intro i; have := hstep k i; linarith
    simp only [h, sum_add_distrib, ← mul_sum, hint k, ih]
    ring

/-- **No net displacement per cycle under linear drag.** If after `P` steps every
node is displaced by the same vector `d` (the body has returned to its shape,
rigidly translated), then `d = 0`, for every positive drag profile. Shape cycles
alone, however asymmetric in space or time, cannot translate a body whose only
external force is linear drag. -/
theorem linear_drag_no_net_displacement {N : ℕ} (dt : ℝ) (ξ : Fin N → ℝ)
    (hξ : ∀ i, 0 < ξ i) (hN : 0 < N)
    (x F : ℕ → Fin N → ℝ)
    (hstep : ∀ n i, ξ i * (x (n + 1) i - x n i) = dt * F n i)
    (hint : ∀ n, ∑ i, F n i = 0)
    (P : ℕ) (d : ℝ) (hcycle : ∀ i, x P i = x 0 i + d) :
    d = 0 := by
  have hfix := drag_weighted_centroid_fixed dt ξ x F hstep hint P
  simp only [hcycle, mul_add, sum_add_distrib] at hfix
  have hsum : ∑ i, ξ i * d = (∑ i, ξ i) * d := by rw [sum_mul]
  have hpos : 0 < ∑ i, ξ i := by
    have : (univ : Finset (Fin N)).Nonempty := ⟨⟨0, hN⟩, mem_univ _⟩
    exact sum_pos (fun i _ => hξ i) this
  have : (∑ i, ξ i) * d = 0 := by linarith
  rcases mul_eq_zero.mp this with h | h
  · linarith
  · exact h

/-- The arithmetic (unweighted) centroid is NOT invariant under heterogeneous
linear drag: drag 1 and 3, internal force ±1, dt = 1. Its change is a shape
effect, which `linear_drag_no_net_displacement` shows cannot accumulate over a
cycle. -/
theorem arithmetic_centroid_moves_with_heterogeneous_drag :
    let ξ : Fin 2 → ℝ := ![1, 3]
    let F : Fin 2 → ℝ := ![1, -1]
    let x1 : Fin 2 → ℝ := fun i => 0 + 1 * F i / ξ i
    (∑ i, F i = 0) ∧ (∑ i, x1 i ≠ 0) ∧ (∑ i, ξ i * x1 i = 0) := by
  simp [Fin.sum_univ_two]
  norm_num

/-! ## C. Two-node crawler with direction-dependent friction -/

/-- Friction force for velocity (or quasi-static displacement) `v`: drag `ξp` for
forward motion, `ξm` for backward motion. -/
noncomputable def fric (ξp ξm v : ℝ) : ℝ := if 0 ≤ v then ξp * v else ξm * v

/-- The displacement coefficient `κ = (ξm − ξp) / (2(ξp + ξm))`. -/
noncomputable def kappa (ξp ξm : ℝ) : ℝ := (ξm - ξp) / (2 * (ξp + ξm))

/-- Net displacement per contraction/extension cycle of length amplitude `A`. -/
noncomputable def cycleDisplacement (ξp ξm A : ℝ) : ℝ := A * (ξm - ξp) / (ξp + ξm)

/-- **Per-step midpoint law.** If the two node displacements `a₁` (rear) and `a₂`
(front) balance friction, `f(a₁) + f(a₂) = 0`, and realise the prescribed length
change `a₂ − a₁ = δ`, then the midpoint moves by `κ·|δ|`, whatever the sign of
`δ` (contraction or extension). -/
theorem crawler_step {ξp ξm a1 a2 δ : ℝ} (hp : 0 < ξp) (hm : 0 < ξm)
    (hbal : fric ξp ξm a1 + fric ξp ξm a2 = 0) (hlen : a2 - a1 = δ) :
    (a1 + a2) / 2 = kappa ξp ξm * |δ| := by
  have hs : 0 < ξp + ξm := by linarith
  unfold fric at hbal
  unfold kappa
  rw [div_mul_eq_mul_div, eq_div_iff (by positivity)]
  by_cases h1 : 0 ≤ a1 <;> by_cases h2 : 0 ≤ a2 <;> simp only [h1, h2, ite_true, ite_false] at hbal
  · -- both forward: balance forces both zero
    have ha1 : a1 = 0 := by nlinarith
    have ha2 : a2 = 0 := by nlinarith
    subst hlen; rw [ha1, ha2]; simp
  · -- rear forward, front backward: contraction
    push Not at h2
    have hd : δ ≤ 0 := by linarith
    rw [abs_of_nonpos hd, ← hlen]
    nlinarith
  · -- rear backward, front forward: extension
    push Not at h1
    have hd : 0 ≤ δ := by linarith
    rw [abs_of_nonneg hd, ← hlen]
    nlinarith
  · -- both backward: impossible unless zero, contradiction with strict negativity
    push Not at h1 h2
    nlinarith

/-- **Pathwise law.** Summing `crawler_step` over any finite actuation history:
the net midpoint displacement equals `κ` times the total variation of the length,
`∑ |δₖ|`. -/
theorem crawler_path {ξp ξm : ℝ} (hp : 0 < ξp) (hm : 0 < ξm) (n : ℕ)
    (a1 a2 δ : ℕ → ℝ)
    (hbal : ∀ k, fric ξp ξm (a1 k) + fric ξp ξm (a2 k) = 0)
    (hlen : ∀ k, a2 k - a1 k = δ k) :
    ∑ k ∈ range n, (a1 k + a2 k) / 2 = kappa ξp ξm * ∑ k ∈ range n, |δ k| := by
  rw [mul_sum]
  exact sum_congr rfl (fun k _ => crawler_step hp hm (hbal k) (hlen k))

/-- **Cycle law.** One contraction by `A` followed by one extension by `A` moves
the midpoint by `A(ξm − ξp)/(ξp + ξm)`. -/
theorem crawler_cycle {ξp ξm A c1 c2 e1 e2 : ℝ} (hp : 0 < ξp) (hm : 0 < ξm)
    (hA : 0 ≤ A)
    (hbc : fric ξp ξm c1 + fric ξp ξm c2 = 0) (hlc : c2 - c1 = -A)
    (hbe : fric ξp ξm e1 + fric ξp ξm e2 = 0) (hle : e2 - e1 = A) :
    (c1 + c2) / 2 + (e1 + e2) / 2 = cycleDisplacement ξp ξm A := by
  rw [crawler_step hp hm hbc hlc, crawler_step hp hm hbe hle]
  unfold kappa cycleDisplacement
  rw [abs_neg, abs_of_nonneg hA]
  have : 0 < ξp + ξm := by linarith
  field_simp
  ring

/-- **Symmetry ⇔ no motion.** For nonzero actuation amplitude, the cycle
displacement vanishes if and only if the friction is isotropic. The `←` direction
is the no-net-displacement-under-symmetry statement; the `→` direction is the
converse: friction anisotropy is NECESSARY for nonzero net displacement. -/
theorem crawler_zero_iff_isotropic {ξp ξm A : ℝ} (hp : 0 < ξp) (hm : 0 < ξm)
    (hA : A ≠ 0) :
    cycleDisplacement ξp ξm A = 0 ↔ ξp = ξm := by
  unfold cycleDisplacement
  have hs : ξp + ξm ≠ 0 := by linarith
  constructor
  · intro h
    rw [div_eq_zero_iff] at h
    rcases h with h | h
    · rcases mul_eq_zero.mp h with h | h
      · exact absurd h hA
      · linarith
    · exact absurd h hs
  · intro h; rw [h]; simp

/-- Direction: the crawler moves forward exactly when backward drag exceeds
forward drag (for positive amplitude). -/
theorem crawler_forward_iff {ξp ξm A : ℝ} (hp : 0 < ξp) (hm : 0 < ξm) (hA : 0 < A) :
    0 < cycleDisplacement ξp ξm A ↔ ξp < ξm := by
  unfold cycleDisplacement
  have hs : 0 < ξp + ξm := by linarith
  rw [div_pos_iff_of_pos_right hs]
  constructor
  · intro h; nlinarith
  · intro h; nlinarith

/-- **Mirror law.** Reflecting the body (swapping which direction is "forward",
i.e. exchanging ξp and ξm) negates the displacement. This is the formal content
of the preregistered `mirror-symmetry` endpoint for this model. -/
theorem crawler_mirror (ξp ξm A : ℝ) :
    cycleDisplacement ξm ξp A = - cycleDisplacement ξp ξm A := by
  unfold cycleDisplacement
  rw [add_comm ξm ξp]
  ring

/-- The cycle displacement is linear in the actuation amplitude. -/
theorem crawler_linear_in_amplitude (ξp ξm A s : ℝ) :
    cycleDisplacement ξp ξm (s * A) = s * cycleDisplacement ξp ξm A := by
  unfold cycleDisplacement; ring

/-- Satisfiability with a genuinely anisotropic substrate: ξp = 1, ξm = 3, a unit
extension is realised by a₁ = −1/4, a₂ = 3/4, balance holds, and the midpoint
moves by 1/4 = κ·1. -/
theorem crawler_hypotheses_satisfiable :
    fric 1 3 (-1/4) + fric 1 3 (3/4) = 0 ∧ (3/4 : ℝ) - (-1/4) = 1 ∧
      ((-1/4 : ℝ) + 3/4) / 2 = kappa 1 3 * |(1 : ℝ)| ∧ cycleDisplacement 1 3 1 = 1/2 := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> norm_num [fric, kappa, cycleDisplacement]

#print axioms total_momentum_step
#print axioms com_fixed_absolute_damping
#print axioms total_momentum_closed_form
#print axioms com_motion_requires_external_force
#print axioms heterogeneous_mass_breaks_com
#print axioms absolute_damping_hypotheses_satisfiable
#print axioms drag_weighted_centroid_fixed
#print axioms linear_drag_no_net_displacement
#print axioms arithmetic_centroid_moves_with_heterogeneous_drag
#print axioms crawler_step
#print axioms crawler_path
#print axioms crawler_cycle
#print axioms crawler_zero_iff_isotropic
#print axioms crawler_forward_iff
#print axioms crawler_mirror
#print axioms crawler_linear_in_amplitude
#print axioms crawler_hypotheses_satisfiable

end ActuationMotion
